# Configuracoes de Email SMTP
# Copie este arquivo para .env e preencha com suas credenciais

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false

SMTP_USERNAME=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app_aqui

# Observacoes:
# - Para Gmail, use uma 'Senha de App' em vez da senha normal
# - Ative a verificacao em 2 etapas na sua conta Google
# - Gere a senha em: https://myaccount.google.com/apppasswords
